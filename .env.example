# ============================================================
#  Скопируй этот файл в .env и заполни значения.
#  Команда:  cp .env.example .env
#  Файл .env НИКОГДА не попадает в git (он в .gitignore).
# ============================================================

# --- Базовое ---------------------------------------------------------------

# Адрес, по которому открывается твой сайт.
# Локально: http://localhost:3000
# На проде:  https://твой-домен.ру
APP_URL=http://localhost:3000

# Секрет для подписи cookie сессий. Любая длинная случайная строка.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если поменяешь - все пользователи разлогинятся. Это нормально.
SESSION_SECRET=

# Где лежит файл базы данных при запуске на ноутбуке (npm run dev).
# В Docker этот путь НЕ используется: docker-compose.yml подставляет
# /data/app.db - папку, примонтированную с диска сервера. Не меняй
# это значение в надежде переехать базу на сервере: там оно ни на что
# не влияет.
DATABASE_PATH=./data/app.db


# --- Мозги продукта (LLM) --------------------------------------------------

# mock              - без ключей и без денег, выдаёт правдоподобную заглушку.
#                     Используй, пока разрабатываешь. Работает прямо сейчас.
# anthropic         - Claude через официальный SDK. Лучшее качество.
# openai-compatible - любой сервис с OpenAI-совместимым API
#                     (в том числе российские шлюзы и self-hosted модели).
LLM_PROVIDER=mock

# Для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Для LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# --- Деньги (ЮKassa) -------------------------------------------------------

# Пока пусто - на странице тарифов честно пишется "оплата скоро".
# Как получить эти два значения - в docs/04-yookassa.md
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Отправлять чек в ЮKassa (нужно по 54-ФЗ, если у тебя подключена онлайн-касса).
# Если касса не подключена - оставь false, иначе платежи будут падать.
YOOKASSA_SEND_RECEIPT=false

# Проверять, что вебхук пришёл действительно с серверов ЮKassa.
# На проде оставь true. Локально при тестах через туннель может мешать -
# тогда временно false (платёж всё равно перепроверяется запросом в API).
YOOKASSA_VERIFY_IP=true


# --- Настройки продукта ----------------------------------------------------

# Сколько бесплатных генераций даём новому пользователю.
# Смысл: человек должен увидеть ценность ДО того, как достанет карту.
FREE_CREDITS_ON_SIGNUP=3
