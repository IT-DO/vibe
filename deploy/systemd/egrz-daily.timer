[Unit]
Description=Ежедневный запуск выгрузки ЕГРЗ в 07:20 МСК

[Timer]
# systemd считает время по системным настройкам контейнера. Если таймзона
# контейнера — UTC (типично для шаблонов Proxmox), 07:20 МСК = 04:20 UTC.
# Проверьте `timedatectl` и поправьте при необходимости.
OnCalendar=*-*-* 04:20:00
# Если контейнер был выключен в момент запуска — выполнить при следующем старте,
# а не ждать сутки.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
