DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
UPLOAD_DIR="./uploads"

# Биллинг (см. /billing и README «Подписка и комиссия»).
# Без двух переменных ниже платежи работают в демо-режиме (оплата отмечается
# сразу, без реального провайдера) — удобно для разработки/тестирования.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
#
# Публичный адрес сайта — используется как return_url для ЮKassa. Если не
# задан, берётся из заголовков запроса (удобно для localhost/LAN, но для
# боевого домена лучше зафиксировать явно).
# APP_URL="https://your-domain.example"
#
# По умолчанию отключено — подписка только считается, но не блокирует
# создание заказов/ставок. Включите "true", когда будете готовы брать деньги.
# SUBSCRIPTION_ENFORCEMENT=false
