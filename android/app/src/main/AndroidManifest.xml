<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Съёмка гостей. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Прямая печать по IPP: обычные TCP-соединения с принтером. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Без этого разрешения Android режет многоадресные пакеты в спящем режиме
      Wi-Fi, и mDNS-поиск принтера молча ничего не находит.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Нужно только чтобы показать имя сети в админке (с Android 10 SSID
      считается геоданными). Функциональность будки от него не зависит:
      без разрешения поле просто пустое.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Экран не должен гаснуть всё мероприятие. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:keepScreenOn="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Планшет-фотобудка должен запускаться сам после перезагрузки и
              не показывать лаунчер: категория HOME делает приложение
              оболочкой устройства. Оператор задаёт его лаунчером по
              умолчанию — порядок в docs/KIOSK-SETUP.md.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Права администратора устройства. Нужны только для «настоящего»
          киоска: назначенное владельцем устройства приложение закрепляет
          экран без запроса, и выйти из него нельзя.
          Порядок назначения — в docs/KIOSK-SETUP.md.
        -->
        <receiver
            android:name=".KioskDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
