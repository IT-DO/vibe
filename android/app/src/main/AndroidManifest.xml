<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Съёмка гостей. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Прямая печать по IPP: обычные TCP-соединения с принтером. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Без этого разрешения Android режет многоадресные пакеты в спящем режиме
      Wi-Fi, и mDNS-поиск принтера молча ничего не находит.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Разрешения на геолокацию здесь намеренно нет.
      С Android 10 имя сети (SSID) считается геоданными, поэтому показать
      его в админке без ACCESS_FINE_LOCATION нельзя. Но приложение всё равно
      никогда не запрашивало это разрешение в рантайме, то есть поле и так
      оставалось пустым, — а объявленное разрешение висело в списке прав.
      Фотобудка, которая просит доступ к местоположению, вызывает вопросы на
      ровном месте. Поиск принтера от этого не страдает: собственный адрес и
      адрес шлюза отдаются без георазрешений.
    -->

    <!-- Экран не должен гаснуть всё мероприятие. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Тактильный отклик на касание. Без этого разрешения Vibrator.vibrate()
      бросает SecurityException в нативном потоке и роняет приложение — со
      стороны это выглядит как «свернулось при нажатии». Разрешение обычное:
      выдаётся при установке, ничего у человека не спрашивает.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Bluetooth. Принтер Xiaomi Portable Photo Printer 1S работает только по
      Bluetooth 5.2 — Wi-Fi у него нет вовсе, а значит нет ни AirPrint, ни
      Mopria. Разрешения разделены по версиям Android намеренно:

      - до Android 12 система требовала разрешение на местоположение даже
        для поиска устройств, потому что по видимым рядом маячкам можно
        определить, где человек находится. Приложению киоска местоположение
        не нужно ни для чего, поэтому оно ограничено версиями, где иначе
        поиск не работает вовсе, и помечено `neverForLocation` — так система
        знает, что мы не пытаемся выяснить, где стоит планшет;
      - с Android 12 появились отдельные разрешения на поиск и подключение,
        и местоположение больше не нужно.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:keepScreenOn="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Категории HOME здесь намеренно нет.
              Она делает приложение оболочкой устройства: планшет-фотобудка
              после перезагрузки сам возвращается в будку, минуя лаунчер. Для
              выделенного планшета это правильно, но на личном телефоне
              приложение попадает в список «выберите приложение главного
              экрана», и случайный выбор превращает телефон в фотобудку —
              откатить это неочевидно.
              Как включить на выделенном устройстве — в docs/KIOSK-SETUP.md.
            -->
        </activity>

        <!--
          Права администратора устройства. Нужны только для «настоящего»
          киоска: назначенное владельцем устройства приложение закрепляет
          экран без запроса, и выйти из него нельзя.
          Порядок назначения — в docs/KIOSK-SETUP.md.
        -->
        <receiver
            android:name=".KioskDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
