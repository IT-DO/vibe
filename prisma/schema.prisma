generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so these are enforced in the TS layer (see src/lib/constants.ts):
// Role: CUSTOMER | EXECUTOR | DESIGNER | ADMIN
// OrderStatus: OPEN | AWARDED | IN_PROGRESS | COMPLETED | CANCELLED
// BidStatus: PENDING | ACCEPTED | REJECTED | WITHDRAWN

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  city         String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  // только для EXECUTOR / DESIGNER (лейблы полей зависят от роли, см. src/lib/constants.ts)
  specialization String? // напр. "FDM, SLA, миниатюры" / "Инженерный CAD, топология"
  materials       String? // материалы печати ИЛИ форматы файлов (STL, STEP, OBJ...)
  printer         String? // модель принтера ИЛИ используемое ПО (Fusion 360, Blender...)
  pricePerGram    Float?
  portfolio       String? // JSON-массив ссылок на изображения

  ordersAsCustomer Order[]      @relation("CustomerOrders")
  bids             Bid[]
  reviewsWritten   Review[]     @relation("ReviewAuthor")
  reviewsReceived  Review[]     @relation("ReviewTarget")
  attachments      Attachment[]
}

model Order {
  id          String   @id @default(cuid())
  customer    User     @relation("CustomerOrders", fields: [customerId], references: [id])
  customerId  String
  title       String
  description String
  material    String
  color       String?
  quantity    Int      @default(1)
  budgetMin   Int?
  budgetMax   Int?
  deadline    DateTime?
  biddingEnds DateTime
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  winningBidId String? @unique

  bids        Bid[]
  reviews     Review[]
  attachments Attachment[]
}

model Bid {
  id           String    @id @default(cuid())
  order        Order     @relation(fields: [orderId], references: [id])
  orderId      String
  executor     User      @relation(fields: [executorId], references: [id])
  executorId   String
  price        Int
  leadTimeDays Int
  message      String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@unique([orderId, executorId])
}

model Review {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  targetId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([orderId, authorId])
}

// storedName — случайное сгенерированное имя файла на диске (никогда не берётся из
// пользовательского ввода, чтобы исключить directory traversal). fileName — исходное
// имя файла, используется только для отображения и заголовка Content-Disposition.
model Attachment {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  uploaderId String
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([orderId])
}
