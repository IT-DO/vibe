DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
UPLOAD_DIR="./uploads"

# Все переменные ниже (кроме трёх выше) можно вместо .env задать через
# /admin/settings на живом сайте (см. README «Админка») — без передеплоя,
# значение из админки побеждает .env. Оставлены здесь как запасной вариант
# и для первого запуска до создания админ-аккаунта.

# Биллинг (см. /billing и README «Подписка и комиссия»).
# Без двух переменных ниже платежи работают в демо-режиме (оплата отмечается
# сразу, без реального провайдера) — удобно для разработки/тестирования.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
#
# Публичный адрес сайта — используется как return_url для ЮKassa. Если не
# задан, берётся из заголовков запроса (удобно для localhost/LAN, но для
# боевого домена лучше зафиксировать явно).
# APP_URL="https://your-domain.example"
#
# По умолчанию отключено — подписка только считается, но не блокирует
# создание заказов/ставок. Включите "true", когда будете готовы брать деньги.
# SUBSCRIPTION_ENFORCEMENT=false

# Почта (восстановление пароля, уведомления). Без этих переменных письма
# только логируются на сервере (см. src/lib/mail.ts) — сброс пароля при этом
# всё равно безопасен (ссылка не показывается в браузере), но реально
# получить письмо пользователь не сможет, пока не задан SMTP.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="PrintAukcion <noreply@your-domain.example>"

# Алерты от scripts/check-disk.sh (нехватка места на диске), отправляются
# через тот же SMTP выше. Сгенерировать токен: openssl rand -hex 24
# ALERT_EMAIL="you@example.com"
# INTERNAL_ALERT_TOKEN=
